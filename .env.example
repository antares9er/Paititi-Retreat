# Copy this file to ".env" and fill in the values.

# Port the server listens on
PORT=3000

# Admin password hash. Generate it with:  npm run set-password
# (the script writes this line for you)
ADMIN_PASSWORD_HASH=

# Set to "production" on the live server. Enables the Secure flag on the
# session cookie, so the site must then be served via HTTPS.
NODE_ENV=development

# Set to 1 when the server runs behind a reverse proxy (nginx, Caddy, Render, ...)
# so the client IP used for login rate limiting is read from X-Forwarded-For.
TRUST_PROXY=0
